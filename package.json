{
  "name": "@masinc/qtk",
  "version": "0.1.4",
  "description": "Local issue / ADR / spec / plan management CLI tool (Bun required)",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "bin": {
    "qtk": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run cli.ts",
    "dev:cli": "bun run cli.ts",
    "dev:web": "bun run scripts/dev-web.ts",
    "test": "bun test ./tests && bun run test:web",
    "test:web": "bun run --filter @masinc/qtk-web test",
    "typecheck": "tsc --noEmit && bun run typecheck:web",
    "typecheck:web": "bun run --filter @masinc/qtk-web svelte-check",
    "build": "bun run build:web && bun run build:cli",
    "build:web": "bun run --filter @masinc/qtk-web build && bun run scripts/copy-static.ts",
    "build:cli": "bun build cli.ts --outdir dist --target bun",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build"
  },
  "keywords": [
    "issue",
    "adr",
    "spec",
    "plan",
    "ticket",
    "cli",
    "markdown",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masinc/qtk.git"
  },
  "files": [
    "dist/",
    "dist/web/static/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "citty": "^0.2.2",
    "cli-table3": "^0.6.0",
    "hono": "^4.13.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "latest",
    "typescript": "^5.0.0"
  }
}
